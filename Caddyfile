# Puerta de entrada del servidor: termina TLS y reparte.
#
# Caddy y no nginx acá porque saca y renueva el certificado de Let's Encrypt
# solo, sin certbot ni cron. Tiendanube NO acepta callbacks por HTTP, así que
# el HTTPS no es opcional: sin certificado no hay integración.
#
# DOMINIO sale del .env. Para probar en una máquina sin dominio real, poner
# DOMINIO=localhost y Caddy usa un certificado propio (el navegador va a
# avisar, y Tiendanube no lo va a aceptar — es solo para probar el ruteo).

{$DOMINIO} {
	encode gzip

	# La API y el admin de Django.
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /admin/* {
		reverse_proxy api:8000
	}

	# Archivos subidos y generados. Caddy sirve DIRECTO, sin login, solo las
	# imágenes que el frontend muestra con <img src> (que no puede mandar el
	# token): miniaturas de rótulos (nombre UUID, no adivinable), vistas
	# previas de plantillas y logos.
	#
	# Todo lo demás de /media tiene datos de compradores y NO se sirve acá:
	# PDFs de lotes (documents/), rótulos pedidos por la tienda (store_labels/),
	# planillas de pedidos importadas (orders/imports/) y fotos subidas para
	# importar (rotulos/). Esos salen solo por la API, que exige sesión o token:
	# /api/v1/documents/<id>/download/ y la descarga firmada de store_labels.
	# Una carpeta nueva bajo media/ queda cerrada hasta que se la agregue acá.
	handle /media/* {
		@media_publica path /media/labels/thumbs/* /media/labels/templates/* /media/labels/logos/* /media/store_logos/*
		handle @media_publica {
			root * /srv
			file_server
		}
		handle {
			respond 404
		}
	}

	# Estáticos de Django (los del admin, básicamente): los deja
	# `collectstatic` en el mismo volumen al arrancar la API.
	handle /static/* {
		root * /srv
		file_server
	}

	# Todo lo demás es el frontend.
	handle {
		reverse_proxy web:8080
	}
}
