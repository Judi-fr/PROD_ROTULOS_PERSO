# =============================================================================
# Plantilla del .env de PRODUCCIÓN (docker-compose.prod.yml)
# =============================================================================
#
# En el servidor, al lado de docker-compose.prod.yml:
#
#   cp .env.prod.example .env
#   chmod 600 .env          # solo lo lee el usuario que despliega
#
# y completar cada valor marcado con <...>. El .env real NUNCA se commitea
# (.gitignore ya lo ignora).
#
# Este archivo es distinto de backend/.env.example, que es el de desarrollo.
#
# -----------------------------------------------------------------------------
# Cómo generar los secretos (correr en el servidor, no copiar los de tu PC):
#
#   SECRET_KEY y POSTGRES_PASSWORD (uno distinto para cada uno):
#     python3 -c "import secrets; print(secrets.token_urlsafe(50))"
#
#   INTEGRATIONS_ENCRYPTION_KEY (clave Fernet: 32 bytes en base64 urlsafe):
#     python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# token_urlsafe solo usa letras, números, "-" y "_": no rompe la URL de la
# base (DATABASE_URL la arma docker-compose con POSTGRES_PASSWORD) ni la
# interpolación de Compose, que trata "$" como variable.
# -----------------------------------------------------------------------------


# --- Dominio -----------------------------------------------------------------
# El mismo dominio en todas las variables de abajo. Tiene que resolver a la IP
# del servidor ANTES de levantar: Caddy lo usa para sacar el certificado HTTPS.
DOMINIO=<rotulos.tudominio.com>


# --- Django ------------------------------------------------------------------
SECRET_KEY=<generar>
# prod.py ya fuerza DEBUG=False, pero base.py exige que la variable exista.
DEBUG=False
# Nunca "*": prod.py se niega a arrancar.
ALLOWED_HOSTS=<rotulos.tudominio.com>
# El frontend se sirve desde el mismo dominio que la API (Caddy reparte).
CORS_ALLOWED_ORIGINS=https://<rotulos.tudominio.com>
# WARNING por defecto en prod; INFO para seguir algo puntual sin redeployar.
# LOG_LEVEL=WARNING


# --- Base de datos (Postgres del compose, no se expone afuera) ---------------
POSTGRES_DB=rotulos
POSTGRES_USER=rotulos
POSTGRES_PASSWORD=<generar>


# --- URLs públicas -----------------------------------------------------------
FRONTEND_URL=https://<rotulos.tudominio.com>
PASSWORD_RESET_URL=https://<rotulos.tudominio.com>/reset-password.html
EMAIL_VERIFICATION_URL=https://<rotulos.tudominio.com>/verify-email.html
# Base de los webhooks y callbacks que se registran en Tiendanube. Sin esto las
# tiendas se conectan pero no se registran webhooks (no llegan pedidos solos).
INTEGRATIONS_PUBLIC_BASE_URL=https://<rotulos.tudominio.com>


# --- Correo (reset de contraseña, verificación de email) ---------------------
# Mejor una casilla del dominio que un Gmail personal. Con Gmail: activar la
# verificación en dos pasos y usar una "contraseña de aplicación".
EMAIL_HOST=<smtp.proveedor.com>
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<no-responder@tudominio.com>
EMAIL_HOST_PASSWORD=<contraseña-de-aplicacion>
DEFAULT_FROM_EMAIL=Rotulos <no-responder@tudominio.com>


# --- Login con Google --------------------------------------------------------
# Google Cloud Console > Google Auth Platform > Clients. Agregar
# https://<rotulos.tudominio.com> en "Orígenes de JavaScript autorizados".
# El mismo client ID está escrito en frontend/index.html y register.html: si se
# usa un cliente distinto para producción, hay que cambiarlo también ahí.
GOOGLE_CLIENT_ID=<xxxx.apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<secreto>


# --- Tiendanube --------------------------------------------------------------
# Portal de Partners > tu app. Redirect URL a cargar ahí:
#   https://<rotulos.tudominio.com>/api/v1/integrations/tiendanube/callback/
TIENDANUBE_APP_ID=<id>
TIENDANUBE_CLIENT_SECRET=<secreto>
# OBLIGATORIO: sin User-Agent Tiendanube responde 400 a toda llamada.
# Formato pedido por Tiendanube: "NombreDeLaApp (email de contacto)".
TIENDANUBE_USER_AGENT=<Rotulos (contacto@tudominio.com)>
# Cifra los tokens de las tiendas guardados en la base. Generarla UNA vez y
# guardarla aparte (gestor de contraseñas): si se pierde o se cambia, todas las
# tiendas conectadas tienen que volver a conectarse.
INTEGRATIONS_ENCRYPTION_KEY=<generar>
# Nombre del medio de envío que ven el comerciante y el comprador en el checkout.
# STORE_LABEL_CARRIER_NAME=Rótulos


# --- Backups (servicio "backup", ver HELP_ME.md) -----------------------------
# Todos los días a BACKUP_HOUR copia la base y media a ./backups (al lado de
# este archivo) y guarda las últimas BACKUP_KEEP_LOCAL. También hace uno al
# arrancar el contenedor.
# BACKUP_HOUR=03:00
# BACKUP_TZ=America/Argentina/Buenos_Aires
# BACKUP_KEEP_LOCAL=7
#
# Copia EXTERNA cifrada con restic (muy recomendable: una copia que vive en el
# mismo servidor se pierde con él). Vacío = solo copia local.
# Ejemplos de RESTIC_REPOSITORY:
#   Cloudflare R2:  s3:https://<account_id>.r2.cloudflarestorage.com/<bucket>
#   Backblaze B2:   s3:https://s3.<region>.backblazeb2.com/<bucket>
#   Storage Box:    sftp:<usuario>@<usuario>.your-storagebox.de:/rotulos
# RESTIC_REPOSITORY=
# Contraseña que cifra las copias. Generarla como las otras claves y GUARDARLA
# en un gestor de contraseñas: sin ella las copias externas no se pueden abrir.
# RESTIC_PASSWORD=<generar>
# Credenciales del bucket (R2 y B2 usan estos nombres aunque no sean de AWS).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=


# --- Importar rótulos desde una foto (Claude) --------------------------------
# Opcional: sin clave, todo funciona menos esa pantalla. Se paga por uso.
# IMPORTANTE: poné además un límite de gasto mensual en la consola de Anthropic
# (console.anthropic.com > Limits). Los límites de abajo frenan abusos, pero el
# único techo real de plata es ese.
# ANTHROPIC_API_KEY=<sk-ant-...>


# --- Opcionales (ya tienen un valor por defecto razonable) -------------------
# Contraseña inicial de los usuarios que crea un admin (quedan obligados a
# cambiarla al entrar). Vacío = el admin la escribe al crear cada usuario.
# ADMIN_CREATED_USER_PASSWORD=
# LABELS_BATCH_MAX_ITEMS=200
# ORDERS_IMPORT_MAX_ROWS=1000
# ORDERS_IMPORT_MAX_FILE_SIZE_MB=10

# --- Límites de uso (rate limits). Formato: N/sec, N/min, N/hour, N/day ------
# Lecturas de rótulos con Claude, por usuario (cada una cuesta plata).
# IMPORTACION_THROTTLE_RATE=20/min
# IMPORTACION_DAILY_THROTTLE_RATE=100/day
# Correos: protegen el cupo diario del SMTP, que es compartido por todos.
# PASSWORD_RESET_EMAIL_THROTTLE_RATE=3/hour
# PASSWORD_RESET_DAILY_THROTTLE_RATE=20/day
# REGISTER_DAILY_THROTTLE_RATE=20/day
# EMAIL_VERIFICATION_HOURLY_THROTTLE_RATE=3/hour
# Dibujar rótulos ocupa un worker de la API: lotes y vistas previas por usuario.
# LABELS_BATCH_THROTTLE_RATE=10/min
# LABELS_RENDER_THROTTLE_RATE=60/min
